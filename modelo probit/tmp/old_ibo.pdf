<style id="wp-custom-css">
.wp-menu li a {
  padding: 10px 15px;
  display: inline-block;
  text-decoration: none;
  border-radius: 50px;
  background-color: transparent;
  color: #fff;
  
}

.wp-menu li:not([class*="current-menu-"]):hover > a {
  background-color: #ba8b48;
  color: #fff;
  border-radius: 50px;
}

.wp-menu > li.current-menu-item > a,
.wp-menu > li.current_page_item > a,
.wp-menu > li.current-menu-ancestor > a,
.wp-menu > li.active > a,
.wp-menu > li.current > a {
  background-color: #ba8b48;
  color: #fff !important;
  border-radius: 50px;
}

@media (max-width: 991px) {
	ul.wp-menu li {
    
    padding: 4px 0px;
}
	.wp-menu li:not([class*="current-menu-"]):hover > a {
    background-color: transparent;
    color: #fff;
    border-radius: 50px;
}
	.ibopeinteligencia_content table {
    border-collapse: collapse;
    margin: 20px 0;
    width: 100%;
    overflow-x: auto;
    display: block;
}
	.logo img {
    width: auto;
    height: auto;
    max-width: 180px !important;
    margin-top: 8px;
}

  .wp-menu li {
    padding: 4px 0;
  }

  .wp-menu li a {
    padding: 10px 15px;
    display: inline-block;
    text-decoration: none;
    border-radius: 50px;
    color: #fff;
  }

